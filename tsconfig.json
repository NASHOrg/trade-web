  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "@pinia/nuxt",
    ],
    "verbatimModuleSyntax": false
  },
  "ts-node": {
    "compilerOptions": {
      "target": "ES2021",
      "module": "CommonJS"
    }
  }
}